{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2020"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": [
      "@figma/plugin-typings"
    ]
  },
  "include": [
    "packages/core/src",
    "packages/plugin/src"
  ]
}
